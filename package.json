{
  "name": "nordic-weather",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:worker": "npm run build && wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p worker",
    "test:worker": "node --test worker/*.test.ts",
    "format": "prettier --write .",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:report": "playwright show-report",
    "check:size": "node scripts/check-size.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
