{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nordic-weather",
  "compatibility_date": "2026-11-15",
  // The Worker script answers /api/* only (the warnings broker, worker/);
  // everything else is the app's files, which Cloudflare serves from dist/
  // directly (free, never reaching the script) with dist/_headers applied.
  // Free plan: 100,000 script calls a day, 10 ms CPU each. Never a paid plan.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Unknown paths get dist/404.html with status 404: the app needs no
    // other paths (places live in the #hash), and scanners shouldn't see
    // /.env or /wp-admin answer 200 with the app's page.
    "not_found_handling": "404-page",
  },
  // The app's own domain (registered in the same Cloudflare account). The
  // deploy points it at this Worker and sets up its certificate.
  "routes": [{ "pattern": "weatherpin.app", "custom_domain": true }],
  // Keep the old workers.dev address working too: saved favourites and
  // settings live per address, and home-screen icons may still use it.
  // (With routes set, it would otherwise be turned off.)
  "workers_dev": true,
}
